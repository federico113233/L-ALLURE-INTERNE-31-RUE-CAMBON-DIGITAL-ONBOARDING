# Copy to .env.local and fill in. Never commit .env.local.

# Claude (Anthropic) — the "brain" of Mademoiselle
ANTHROPIC_API_KEY=
# Optional override (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# ElevenLabs — voice (TTS) and transcription (Scribe STT)
ELEVENLABS_API_KEY=
# Filled automatically by `npm run voice:save <generated_voice_id>`
ELEVENLABS_VOICE_ID=
# Optional overrides
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2
